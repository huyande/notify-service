# 服务配置
APP_PORT=3000

# 日志配置
# 日志级别: log | error | warn | debug | verbose
LOG_LEVEL=log

# Redis（BullMQ 与缓存共用）
REDIS_HOST=localhost
REDIS_PORT=6379

# 微信小程序 AppSecret（对应 config/apps.yaml 中的环境变量占位）
WECHAT_APP_SECRET_COURSE=
REDIS_PASSWORD=

# Swagger 配置
SWAGGER_ENABLED=true

# Bull Board 队列仪表盘（只读、需邮箱+密码登录）
# 账户白名单：email:password,email:password（密码不得含逗号或冒号）
BULL_BOARD_ACCOUNTS=
# 会话签名密钥（必填，长随机串；缺失将导致启动失败）
BULL_BOARD_SESSION_SECRET=
# 面板路径（可写在 .env）
BULL_BOARD_PATH=/admin/queues
