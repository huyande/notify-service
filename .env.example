# 服务配置
APP_PORT=3000

# 日志配置
# 日志级别: log | error | warn | debug | verbose
# - log:   一般信息（默认）
# - error: 仅错误
# - warn:  警告及以上
# - debug: 调试及以上（包含所有）
# - verbose: 最详细（包含所有）
LOG_LEVEL=log

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wx_nest
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_TIMEZONE=+08:00

# JWT 配置
JWT_ACCESS_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Swagger 配置
SWAGGER_ENABLED=true
